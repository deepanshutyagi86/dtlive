# --- Postgres (Neon, via Vercel's Marketplace integration — the direct
# successor to the old "Vercel Postgres" product, same Storage tab) ---
# Add a Postgres/Neon integration in your Vercel dashboard -> Storage tab.
# Vercel injects DATABASE_URL automatically once it's connected to this
# project; copy it here for local dev.
DATABASE_URL=""

# --- Admin auth (single admin user, no external service needed) ---
# Generate a bcrypt hash of your chosen password, e.g. via
# node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD_HASH=""
# Any long random string — used to sign the admin session cookie.
ADMIN_SESSION_SECRET="change-me-to-a-long-random-string"

# --- Cashfree (sandbox first, swap to production values at launch) ---
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
CASHFREE_ENV="SANDBOX" # SANDBOX | PRODUCTION
CASHFREE_WEBHOOK_SECRET=""

# --- Public site URL (used for Cashfree return_url + OG tags) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Mirrors CASHFREE_ENV but exposed client-side for the Cashfree JS SDK.
NEXT_PUBLIC_CASHFREE_ENV="SANDBOX"

# --- Meta Pixel + Conversions API ---
# Optional. If either is unset, the Pixel isn't injected and server-side
# CAPI events are skipped with a console warning — nothing else breaks.
META_PIXEL_ID=""
META_CAPI_TOKEN=""
