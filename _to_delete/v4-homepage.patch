+              <a href={links.youtube} className="v4-btn v4-b-line" target="_blank" rel="noopener noreferrer">
+                YouTube
+              </a>
+            )}
+          </div>
+          <div className="v4-fgrid">
+            <div>
+              <p className="v4-m v4-muted-dark">Learn</p>
+              <Link href="/courses">Courses</Link>
+              <Link href="/workshops">Workshops</Link>
+              <Link href="/guide">Free guides</Link>
+            </div>
+            <div>
+              <p className="v4-m v4-muted-dark">Work</p>
+              <Link href="/agency">Studio</Link>
+              <Link href="/shop">Shop</Link>
+              <Link href="/ventures">Ventures</Link>
+              <Link href="/portfolio">Portfolio ↗</Link>
+            </div>
+            <div>
+              <p className="v4-m v4-muted-dark">Legal</p>
+              <Link href="/terms">Terms</Link>
+              <Link href="/privacy">Privacy</Link>
+              <Link href="/refund-policy">Refunds</Link>
+              <Link href="/shipping-policy">Shipping</Link>
+            </div>
+            <div>
+              <p className="v4-m v4-muted-dark">Contact</p>
+              {links.email && <a href={`mailto:${links.email}`}>{links.email}</a>}
+              {links.linkedin && (
+                <a href={links.linkedin} target="_blank" rel="noopener noreferrer">
+                  LinkedIn
+                </a>
+              )}
+              <p className="v4-foot-small">© {year} Deepanshu Tyagi · Meerut, UP</p>
+            </div>
+          </div>
+        </div>
+      </footer>
+
+      {/* ---------- phone tab bar ---------- */}
+      <nav className="v4-tabbar" aria-label="Sections">
+        {tabs.map((t) => (
+          <button
+            key={t.id}
+            type="button"
+            className={`v4-tb ${active === t.id ? "is-on" : ""}`}
+            aria-current={active === t.id ? "true" : undefined}
+            onClick={() => go(t.id)}
+          >
+            <Icon d={t.icon} size={20} />
+            {t.label}
+          </button>
+        ))}
+      </nav>
+
+      {mounted && sheetCourse && (
+        <CourseSheet
+          course={sheetCourse}
+          fontVars={fontVars}
+          gstin={gstin}
+          onClose={() => setSheetId(null)}
+          triggerRef={sheetTrigger}
+        />
+      )}
+    </div>
+  );
+}
diff --git a/src/components/v4/fonts.ts b/src/components/v4/fonts.ts
new file mode 100644
index 0000000..d310073
--- /dev/null
+++ b/src/components/v4/fonts.ts
@@ -0,0 +1,29 @@
+import { Inter_Tight, Instrument_Serif, JetBrains_Mono } from "next/font/google";
+
+// The V4 homepage type system. Scoped to the homepage on purpose: the rest
+// of the site still sets Bricolage / Instrument Sans / Space Mono from the
+// root layout, so these three only download on "/".
+export const interTight = Inter_Tight({
+  subsets: ["latin"],
+  variable: "--v4-sans",
+  display: "swap",
+});
+
+export const instrumentSerif = Instrument_Serif({
+  subsets: ["latin"],
+  weight: "400",
+  style: ["normal", "italic"],
+  variable: "--v4-serif",
+  display: "swap",
+});
+
+// Small caps-style labels only — never the LCP, so no preload race.
+export const jetbrains = JetBrains_Mono({
+  subsets: ["latin"],
+  weight: ["400", "600"],
+  variable: "--v4-mono",
+  display: "swap",
+  preload: false,
+});
+
+export const V4_FONT_VARS = `${interTight.variable} ${instrumentSerif.variable} ${jetbrains.variable}`;
