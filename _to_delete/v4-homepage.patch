@@ -0,0 +1,585 @@
+/* ==================================================================
+   V4 homepage — "Spiral → Ship".
+   Every selector is scoped under .v4 so nothing here leaks into the
+   rest of the site, which keeps its own Tailwind styling.
+   Motion: transform/opacity only; all of it off under reduced-motion.
+   ================================================================== */
+
+.v4 {
+  --paper: #efede6;
+  --paper-2: #e6e3da;
+  --ink: #0e0e0c;
+  --ink-2: #45443d;
+  --mut: #6b6a60;
+  --mut-dark: #a5a396;
+  --gold: #f5a300;
+  --gold-ink: #8a5a00;
+  --live: #ff3b30;
+  --line: rgba(14, 14, 12, 0.1);
+  font-family: var(--v4-sans), "Helvetica Neue", Arial, sans-serif;
+  color: var(--ink);
+  background: var(--paper);
+  -webkit-font-smoothing: antialiased;
+  font-size: 16px;
+  line-height: 1.5;
+  overflow-x: clip;
+}
+.v4 *,
+.v4 *::before,
+.v4 *::after {
+  box-sizing: border-box;
+}
+.v4 a {
+  color: inherit;
+}
+
+/* type */
+.v4 .v4-d {
+  font-family: var(--v4-sans), sans-serif;
+  font-weight: 700;
+  letter-spacing: -0.045em;
+}
+.v4 .v4-sf {
+  font-family: var(--v4-serif), Georgia, serif;
+  font-style: italic;
+  font-weight: 400;
+  letter-spacing: -0.015em;
+}
+.v4 .v4-m {
+  font-family: var(--v4-mono), ui-monospace, monospace;
+  font-size: 11px;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+}
+.v4 .v4-muted { color: var(--mut); }
+.v4 .v4-muted-dark { color: var(--mut-dark); }
+.v4 .v4-gold { color: var(--gold); }
+.v4 .v4-gold-ink { color: var(--gold-ink); }
+.v4 .v4-center { text-align: center; }
+.v4 .v4-wrap { width: 100%; max-width: 1240px; margin: 0 auto; padding: 0 20px; }
+.v4 .v4-sec { padding: 72px 0; scroll-margin-top: 64px; }
+.v4 .v4-row { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
+.v4 .v4-row-tight { gap: 6px; }
+.v4 .v4-lede { margin: 0; max-width: 470px; font-size: 18px; line-height: 1.45; color: var(--ink-2); }
+.v4 .v4-kick { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 18px; }
+.v4 .v4-kick a { text-decoration: none; }
+.v4 .v4-h2 { margin: 0 0 26px; font-size: clamp(40px, 6vw, 88px); line-height: 0.92; }
+
+/* buttons */
+.v4 .v4-btn,
+.v4-btn {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 10px;
+  min-height: 50px;
+  padding: 0 22px;
+  border-radius: 999px;
+  border: 0;
+  font: 600 15px var(--v4-sans), sans-serif;
+  text-decoration: none;
+  cursor: pointer;
+  transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), background-color 0.2s, color 0.2s, box-shadow 0.2s;
+}
+.v4 .v4-btn:hover { transform: translateY(-2px); }
+.v4 .v4-btn:active { transform: scale(0.97); }
+.v4 .v4-b-ink { background: var(--ink); color: var(--paper); }
+.v4 .v4-b-ink:hover { background: #2a2a25; }
+.v4 .v4-b-gold { background: var(--gold); color: var(--ink); }
+.v4 .v4-b-gold:hover { background: #ffb524; }
+.v4 .v4-b-line { background: transparent; color: inherit; box-shadow: inset 0 0 0 1.5px currentColor; }
+.v4 .v4-btn-sm { min-height: 40px; padding: 0 16px; font-size: 14px; }
+.v4 .v4-btn-card { min-height: 46px; padding: 0 12px; width: 100%; }
+.v4 .v4-w-full { width: 100%; }
+.v4 .v4-arr { display: inline-block; transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1); }
+.v4 .v4-btn:hover .v4-arr,
+.v4 .v4-pill:hover .v4-arr { transform: translateX(4px); }
+
+.v4 .v4-dot {
+  display: inline-block;
+  width: 8px;
+  height: 8px;
+  border-radius: 50%;
+  background: var(--live);
+  flex-shrink: 0;
+  animation: v4-ping 1.8s ease-out infinite;
+}
+.v4 .v4-dot-lg { width: 12px; height: 12px; margin: 7px; }
+@keyframes v4-ping {
+  0% { box-shadow: 0 0 0 0 rgba(255, 59, 48, 0.5); }
+  80%, 100% { box-shadow: 0 0 0 9px rgba(255, 59, 48, 0); }
+}
+
+/* top bar */
+.v4 .v4-top {
+  position: sticky;
+  top: 0;
+  z-index: 40;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 16px;
+  padding: 12px 20px;
+  background: rgba(239, 237, 230, 0.84);
+  backdrop-filter: blur(14px);
+  -webkit-backdrop-filter: blur(14px);
+  border-bottom: 1px solid rgba(14, 14, 12, 0.08);
+}
+.v4 .v4-logo { text-decoration: none; font-size: 21px; letter-spacing: -0.05em; }
+.v4 .v4-logo span { color: var(--gold); }
+.v4 .v4-top-links { display: none; gap: 26px; }
+.v4 .v4-top-links a { text-decoration: none; font-size: 14px; font-weight: 500; color: var(--ink-2); }
+.v4 .v4-top-links a:hover { color: var(--ink); }
+
+/* hero */
+.v4 .v4-hero { position: relative; padding: 28px 0 36px; overflow: hidden; }
+.v4 .v4-spiral {
+  position: absolute;
+  right: -90px;
+  top: -40px;
+  width: 520px;
+  height: 520px;
+  pointer-events: none;
+  animation: v4-compress 1.1s cubic-bezier(0.7, 0, 0.2, 1) 1.1s both;
+}
+.v4 .v4-spiral svg { width: 100%; height: 100%; animation: v4-spin 80s linear infinite; }
+.v4 .v4-spiral-text {
+  font: 500 11.5px var(--v4-mono), monospace;
+  letter-spacing: 0.06em;
+  fill: var(--ink);
+}
+@keyframes v4-spin { to { transform: rotate(360deg); } }
+@keyframes v4-compress {
+  from { transform: none; opacity: 0.9; }
+  to { transform: scale(0.62) rotate(140deg); opacity: 0.13; }
+}
+.v4 .v4-hero-copy { position: relative; display: flex; flex-direction: column; gap: 22px; }
+.v4 .v4-hero-copy > .v4-m { margin: 0; }
+.v4 .v4-h1 {
+  margin: 0;
+  font-size: clamp(54px, 10vw, 150px);
+  line-height: 0.86;
+  animation: v4-rise 1s cubic-bezier(0.2, 0.8, 0.2, 1) 1.3s both;
+}
+.v4 .v4-h1 .v4-sf { letter-spacing: -0.02em; }
+.v4 .v4-after { display: flex; flex-direction: column; gap: 22px; animation: v4-fade 0.8s ease 1.9s both; }
+@keyframes v4-rise { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: none; } }
+@keyframes v4-fade { from { opacity: 0; } to { opacity: 1; } }
+.v4 .v4-pill {
+  display: inline-flex;
+  align-items: center;
+  gap: 10px;
+  min-height: 44px;
+  padding: 0 16px 0 14px;
+  border-radius: 999px;
+  background: var(--ink);
+  color: var(--paper);
+  text-decoration: none;
+  font-size: 14px;
+  font-weight: 500;
+}
+.v4 .v4-pill:hover { color: var(--gold); }
+.v4 .v4-replay {
+  min-height: 44px;
+  padding: 0 6px;
+  border: 0;
+  background: transparent;
+  color: var(--mut);
+  cursor: pointer;
+  font: 500 11px var(--v4-mono), monospace;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+}
+.v4 .v4-replay:hover { color: var(--ink); }
+
+/* shortcuts */
+.v4 .v4-cuts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
+.v4 .v4-cut {
+  position: relative;
+  display: flex;
+  flex-direction: column;
+  justify-content: space-between;
+  gap: 22px;
+  min-height: 132px;
+  padding: 16px;
+  border-radius: 20px;
+  background: #fff;
+  border: 1px solid rgba(14, 14, 12, 0.08);
+  text-decoration: none;
+  overflow: hidden;
+  transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.4s;
+}
+.v4 .v4-cut:hover { transform: translateY(-4px); box-shadow: 0 20px 40px -24px rgba(14, 14, 12, 0.35); }
+.v4 .v4-cut-dark { background: var(--ink); color: var(--paper); border-color: var(--ink); }
+.v4 .v4-cut-gold { background: var(--gold); border-color: var(--gold); }
+.v4 .v4-cut-t { display: block; font-size: 22px; letter-spacing: -0.03em; }
+.v4 .v4-go {
+  position: absolute;
+  top: 14px;
+  right: 14px;
+  width: 30px;
+  height: 30px;
+  border-radius: 50%;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  background: rgba(127, 125, 112, 0.14);
+  transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
+}
+.v4 .v4-cut:hover .v4-go { transform: rotate(-45deg); }
+
+/* crossing bands */
+.v4 .v4-bands { position: relative; height: 150px; overflow: hidden; }
+.v4 .v4-band { position: absolute; left: -6%; width: 112%; display: flex; overflow: hidden; white-space: nowrap; }
+.v4 .v4-band-a { top: 30px; background: var(--ink); color: var(--paper); transform: rotate(-3deg); z-index: 2; }
+.v4 .v4-band-b { top: 78px; background: var(--gold); color: var(--ink); transform: rotate(2deg); }
+.v4 .v4-trk { display: flex; flex-shrink: 0; animation: v4-marq 34s linear infinite; }
+.v4 .v4-band-b .v4-trk { animation-direction: reverse; animation-duration: 42s; }
+.v4 .v4-trk-item { display: inline-flex; align-items: center; }
+.v4 .v4-trk-item span { padding: 12px 18px; font: 700 17px var(--v4-sans), sans-serif; letter-spacing: -0.02em; }
+.v4 .v4-trk-item i { font-style: normal; padding: 12px 2px; opacity: 0.55; }
+@keyframes v4-marq { to { transform: translateX(-100%); } }
+
+/* course shelf */
+.v4 .v4-learn { padding-top: 40px; }
+.v4 .v4-shelf {
+  display: flex;
+  gap: 12px;
+  overflow-x: auto;
+  scroll-snap-type: x mandatory;
+  padding: 4px 20px 18px;
+  margin: 0 -20px;
+  scrollbar-width: none;
+}
+.v4 .v4-shelf::-webkit-scrollbar { display: none; }
+.v4 .v4-card {
+  flex: 0 0 82%;
+  scroll-snap-align: start;
+  display: flex;
+  flex-direction: column;
+  border-radius: 22px;
+  background: #fff;
+  border: 1px solid rgba(14, 14, 12, 0.08);
+  overflow: hidden;
+  transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.45s;
+}
+.v4 .v4-card:hover { transform: translateY(-6px); box-shadow: 0 26px 50px -28px rgba(14, 14, 12, 0.4); }
+.v4 .v4-cov { position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: #e3e0d6; }
+.v4 .v4-pic { object-fit: cover; object-position: top; transition: transform 1s cubic-bezier(0.2, 0.8, 0.2, 1), filter 0.6s; }
+.v4 .v4-card:hover .v4-pic { transform: scale(1.05); }
+.v4 .v4-pic-empty { position: absolute; inset: 0; background: repeating-linear-gradient(135deg, #e3e0d6 0 12px, #dcd8cc 12px 24px); }
+.v4 .v4-tag { position: absolute; left: 12px; top: 12px; padding: 6px 10px; border-radius: 999px; background: rgba(14, 14, 12, 0.82); color: var(--paper); }
+.v4 .v4-cbody { padding: 16px; display: flex; flex-direction: column; gap: 12px; flex: 1; }
+.v4 .v4-card-t { margin: 0; font-size: 26px; line-height: 1; letter-spacing: -0.035em; }
+.v4 .v4-card-p {
+  margin: 0;
+  flex: 1;
+  font-size: 15px;
+  line-height: 1.45;
+  color: var(--ink-2);
+  display: -webkit-box;
+  -webkit-line-clamp: 3;
+  -webkit-box-orient: vertical;
+  overflow: hidden;
+}
+.v4 .v4-price-row { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; flex-wrap: wrap; }
+.v4 .v4-price { font: 700 24px var(--v4-sans), sans-serif; letter-spacing: -0.03em; }
+.v4 .v4-card-btns { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
+.v4 .v4-note-line { margin: 10px 0 0; }
+
+/* live ticket */
+.v4 .v4-live { padding-top: 24px; }
+.v4 .v4-ticket { display: grid; grid-template-columns: 1fr; border-radius: 24px; overflow: hidden; background: var(--ink); color: var(--paper); }
+.v4 .v4-stub { position: relative; padding: 22px; display: flex; flex-direction: column; gap: 6px; background: var(--gold); color: var(--ink); }
+.v4 .v4-stub::after {
+  content: "";
+  position: absolute;
+  left: 0;
+  right: 0;
+  bottom: -1px;
+  height: 12px;
+  background: radial-gradient(circle at 8px -2px, transparent 7px, var(--ink) 7.5px) 0 0 / 16px 12px repeat-x;
+}
+.v4 .v4-stub-big { font-size: clamp(40px, 6vw, 56px); line-height: 0.95; letter-spacing: -0.05em; }
+.v4 .v4-tbody { padding: 24px 22px; display: flex; flex-direction: column; align-items: flex-start; gap: 16px; }
+.v4 .v4-t-p { margin: 0; font-size: 18px; line-height: 1.45; }
+
+/* studio */
+.v4 .v4-studio { background: var(--paper-2); }
+.v4 .v4-studio-copy { display: flex; flex-direction: column; gap: 18px; margin-bottom: 28px; }
+.v4 .v4-studio-copy .v4-h2 { margin: 0; }
+.v4 .v4-studio-price { font-size: 22px; letter-spacing: -0.03em; }
+.v4 .v4-demo { display: flex; flex-direction: column; gap: 14px; }
+.v4 .v4-tabs { display: flex; gap: 6px; }
+.v4 .v4-tab {
+  flex: 1;
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  min-height: 56px;
+  padding: 10px 0 0;
+  border: 0;
+  background: transparent;
+  color: var(--mut);
+  font: 600 14px var(--v4-sans), sans-serif;
+  text-align: left;
+  cursor: pointer;
+}
+.v4 .v4-tab.is-on { color: var(--ink); }
+.v4 .v4-tab i { display: block; height: 3px; border-radius: 3px; background: rgba(14, 14, 12, 0.12); overflow: hidden; }
+.v4 .v4-tab i b { display: block; height: 100%; width: 0; background: var(--ink); }
+.v4 .v4-tab.is-on i b { animation: v4-fill 3.2s linear forwards; }
+.v4 .v4-tab.is-done i b { width: 100%; }
+@keyframes v4-fill { to { width: 100%; } }
+.v4 .v4-browser { border-radius: 18px; background: #fff; border: 1px solid var(--line); overflow: hidden; box-shadow: 0 30px 60px -36px rgba(14, 14, 12, 0.45); }
+.v4 .v4-bar { display: flex; align-items: center; gap: 6px; padding: 10px 12px; border-bottom: 1px solid rgba(14, 14, 12, 0.08); }
+.v4 .v4-bar > span { width: 9px; height: 9px; border-radius: 50%; background: #d9d6cc; }
+.v4 .v4-url { margin-left: 8px; flex: 1; padding: 6px 10px; border-radius: 8px; background: #f3f1ea; color: var(--mut); }
+.v4 .v4-canvas { position: relative; height: 260px; padding: 14px; overflow: hidden; }
+.v4 .v4-blocks { display: flex; flex-direction: column; gap: 10px; height: 100%; }
+.v4 .v4-blk-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; flex: 1; }
