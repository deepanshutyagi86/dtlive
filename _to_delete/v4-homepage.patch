+function Pic({
+  src,
+  alt,
+  sizes,
+  focal,
+  priority = false,
+}: {
+  src: string | null;
+  alt: string;
+  sizes: string;
+  focal?: ImageFocal | null;
+  priority?: boolean;
+}) {
+  if (!src) return <div className="v4-pic-empty" aria-hidden="true" />;
+  return (
+    <Image
+      src={src}
+      alt={alt}
+      fill
+      sizes={sizes}
+      priority={priority}
+      unoptimized={!isOptimisableImage(src)}
+      className="v4-pic"
+      style={focal ? { objectPosition: `${focal.x}% ${focal.y}%` } : undefined}
+      draggable={false}
+    />
+  );
+}
